<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Belajar Ilmu Tajwid dari Enol</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Playfair+Display:wght@600&family=Source+Serif+4:wght@400;600&display=swap">
<style>
:root{--bg:#101615;--pn:#182120;--tx:#eee3cc;--mu:#a9a28f;--gd:#d9b36c;--on:#1a1409;--ln:#2f3b38;--g:#6fd08c;--m:#ff8a65;--q:#79b8ff;--ar:1.9rem;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:dark}
:root[data-theme=light]{--bg:#f4ecda;--pn:#fffaf0;--tx:#2a2a24;--mu:#6b6556;--gd:#8a5a12;--on:#fffaf0;--ln:#dccfb0;--g:#1d7a3e;--m:#c0391b;--q:#1f5fae;color-scheme:light}
@media(prefers-color-scheme:light){:root:not([data-theme=dark]){--bg:#f4ecda;--pn:#fffaf0;--tx:#2a2a24;--mu:#6b6556;--gd:#8a5a12;--on:#fffaf0;--ln:#dccfb0;--g:#1d7a3e;--m:#c0391b;--q:#1f5fae;color-scheme:light}}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 60px)}
*{box-sizing:border-box}[hidden]{display:none!important}
body{margin:0;background:var(--bg);color:var(--tx);font:1.05rem/1.75 "Source Serif 4",Georgia,serif}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--pn);z-index:10}
button{font:inherit;cursor:pointer;color:inherit}
:focus-visible{outline:2px solid var(--gd);outline-offset:2px}
.cover{position:fixed;inset:0;display:flex;flex-direction:column;background:#0c1011;z-index:20}
.cover .img{flex:1;background:center top/cover no-repeat}
.cover .bar{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;padding:12px 12px calc(12px + env(safe-area-inset-bottom,0px));background:#0c1011}
@media(min-aspect-ratio:1/1){.cover .img{background-size:contain;background-position:center}}
.btn{background:var(--gd);color:var(--on);border:0;border-radius:999px;padding:.55rem 1.6rem;font-weight:600}
.btn.o{background:none;color:var(--gd);border:1px solid var(--gd)}
.cover .btn{background:#d9b36c;color:#1a1409}.cover .btn.o{background:none;color:#d9b36c}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:11;display:flex;align-items:center;gap:6px;padding:8px 12px;background:var(--pn);border-bottom:1px solid var(--ln)}
header b{font:600 1.05rem "Playfair Display",Georgia,serif;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
header button{background:none;border:1px solid var(--ln);border-radius:8px;min-width:38px;height:38px;font-family:Amiri,serif;font-size:1.05rem}
#side{position:fixed;top:0;bottom:0;left:0;width:min(86vw,320px);background:var(--pn);border-right:1px solid var(--ln);padding:calc(env(safe-area-inset-top,0px) + 62px) 14px 14px;overflow-y:auto;transform:translateX(-100%);transition:transform .2s;z-index:9}
#side.open{transform:none}
#side input{width:100%;padding:.5rem .7rem;border:1px solid var(--ln);border-radius:8px;background:var(--bg);color:var(--tx);font:inherit;font-size:.95rem}
.pb{height:6px;background:var(--ln);border-radius:3px;margin:10px 0 2px}.pb i{display:block;height:100%;background:var(--gd);border-radius:3px}
#side small{color:var(--mu)}
#toc{list-style:none;margin:10px 0;padding:0}
#toc button{width:100%;text-align:left;background:none;border:0;border-radius:8px;padding:.45rem .6rem;font-size:.98rem;line-height:1.4}
#toc button.on{background:var(--bg);color:var(--gd);font-weight:600}
main{max-width:720px;margin:0 auto;padding:22px 18px 60px}
@media(min-width:960px){#side{transform:none;z-index:5}main{margin-left:calc(320px + (100vw - 320px - 720px)/2)}#mn{display:none}}
h1{font:600 1.9rem/1.25 "Playfair Display",Georgia,serif;color:var(--gd);margin:.2em 0 .6em}
h2{font:600 1.2rem "Playfair Display",Georgia,serif;margin:1.6em 0 .4em}
.ar,td.a{font-family:Amiri,"Noto Naskh Arabic",serif;direction:rtl}
.ex{background:var(--pn);border:1px solid var(--ln);border-radius:10px;padding:10px 16px;margin:12px 0}
.ex .ar{display:block;font-size:var(--ar);line-height:2.1;text-align:right}
.ex small{color:var(--mu)}
td.a,.ex .ar{font-size:var(--ar)}td.a{font-size:calc(var(--ar)*.8);white-space:nowrap}
i.g,i.m,i.q{font-style:normal}i.g{color:var(--g)}i.m{color:var(--m)}i.q{color:var(--q)}
.note{border-left:4px solid var(--gd);background:var(--pn);padding:10px 14px;border-radius:0 10px 10px 0;margin:16px 0}
table{display:block;overflow-x:auto;border-collapse:collapse;margin:12px 0;font-size:.95rem}
th,td{border:1px solid var(--ln);padding:6px 10px;text-align:left;vertical-align:top}th{background:var(--pn);color:var(--gd)}
.quiz{border-top:1px solid var(--ln);margin-top:2.2rem}
.q p{margin:1em 0 .4em;font-weight:600}
.q button{display:block;width:100%;text-align:left;margin:6px 0;padding:.55rem .8rem;background:var(--pn);border:1px solid var(--ln);border-radius:10px}
.q button.ok{border-color:var(--g);background:color-mix(in srgb,var(--g) 18%,var(--pn))}
.q button.no{border-color:var(--m);background:color-mix(in srgb,var(--m) 18%,var(--pn))}
.pn{display:flex;justify-content:space-between;gap:10px;margin-top:2rem}
</style>
</head>
<body>
<section class="cover" id="front"><div class="img" style="background-image:url(data:image/jpeg;base64,)" role="img" aria-label="Sampul depan: Belajar Ilmu Tajwid dari Enol"></div><div class="bar"><button class="btn" id="open">Buka Buku</button></div></section>

<section id="read" hidden>
<header><button id="mn" aria-label="Daftar isi">☰</button><b>Belajar Ilmu Tajwid dari Enol</b><button id="ar-" aria-label="Kecilkan huruf Arab">ع−</button><button id="ar+" aria-label="Besarkan huruf Arab">ع+</button><button id="th" aria-label="Ganti mode terang atau gelap">◐</button></header>
<nav id="side"><input id="s" type="search" placeholder="Cari materi" aria-label="Cari materi"><div class="pb"><i id="bar"></i></div><small id="prog"></small><ul id="toc"></ul><button class="btn o" id="tf">Sampul depan</button></nav>
<main id="ch"></main>
</section>

<section class="cover" id="back" hidden><div class="img" style="background-image:url(data:image/jpeg;base64,)" role="img" aria-label="Sampul belakang buku"></div><div class="bar"><button class="btn o" id="bt">Daftar isi</button><button class="btn" id="b0">Kembali ke awal</button></div></section>

<script>
const J=(t,r)=>`<tr><td>${t}</td><td class="a">${r}</td></tr>`;
const C=[
{t:"Pengantar ilmu tajwid",h:`<p>Tajwid secara bahasa berarti memperbagus. Secara istilah, tajwid adalah mengucapkan setiap huruf Al-Qur'an dari tempat keluarnya dengan memberi hak dan sifat-sifatnya.</p><h2>Hukum mempelajarinya</h2><p>Mempelajari ilmu tajwid hukumnya fardhu kifayah. Membaca Al-Qur'an dengan tajwid hukumnya fardhu 'ain bagi setiap muslim yang membacanya.</p><h2>Tujuan</h2><p>Menjaga lisan dari kesalahan bacaan (lahn), baik yang jelas maupun yang halus.</p><div class="ex"><span class="ar">وَرَتِّلِ الْقُرْآنَ تَرْتِيلًا</span><small>QS. Al-Muzzammil: 4. Bacalah Al-Qur'an dengan tartil.</small></div><aside class="note"><b>Perhatikan.</b> Di contoh ayat, warna <i class="g">hijau</i> menandai dengung dan ikhfa, <i class="m">merah</i> menandai mad, dan <i class="q">biru</i> menandai qalqalah.</aside>`,q:[["Hukum mempelajari ilmu tajwid adalah...",["Sunnah","Fardhu kifayah","Mubah"],1],["Tajwid secara bahasa berarti...",["Memperbagus","Menghafal","Menulis"],0]]},
{t:"Makharijul huruf",h:`<p>Makhraj adalah tempat keluarnya huruf. Ada lima tempat umum.</p><table><tr><th>Tempat</th><th>Huruf</th></tr>${J("Al-Jauf (rongga mulut dan tenggorokan): huruf mad","ا و ي")}${J("Al-Halq, pangkal tenggorokan","ء ه")}${J("Al-Halq, tengah tenggorokan","ع ح")}${J("Al-Halq, ujung tenggorokan","غ خ")}${J("Al-Lisan (lidah), 18 huruf","ق ك ج ش ي ض ل ن ر ط د ت ص ز س ظ ذ ث")}${J("Asy-Syafatain (bibir)","ف و ب م")}${J("Al-Khaisyum (rongga hidung): dengung","غنة")}</table><aside class="note"><b>Perhatikan.</b> Huruf <span class="ar">ء</span> dan <span class="ar">ه</span> keluar dari pangkal tenggorokan, jauh di belakang. Jangan tertukar dengan <span class="ar">ع</span> dan <span class="ar">ح</span>.</aside>`,q:[["Huruf ع keluar dari...",["Bibir","Tengah tenggorokan","Rongga hidung"],1],["Huruf ف dan ب keluar dari...",["Lidah","Bibir","Tenggorokan"],1]]},
{t:"Sifatul huruf",h:`<p>Sifat huruf adalah keadaan huruf saat diucapkan. Sifat yang berlawanan:</p><table><tr><th>Sifat</th><th>Arti</th><th>Lawan</th></tr><tr><td>Hams</td><td>nafas mengalir</td><td>Jahr</td></tr><tr><td>Syiddah</td><td>suara tertahan</td><td>Rakhawah</td></tr><tr><td>Isti'la</td><td>pangkal lidah naik</td><td>Istifal</td></tr></table><h2>Huruf isti'la (7)</h2><div class="ex"><span class="ar">خ ص ض غ ط ق ظ</span><small>Dibaca tebal (tafkhim).</small></div><p>Sifat tanpa lawan antara lain qalqalah, shafir, layyin, inhiraf, takrir, tafasysyi, dan istithalah.</p>`,q:[["Lawan dari sifat jahr adalah...",["Hams","Syiddah","Qalqalah"],0],["Huruf isti'la berjumlah...",["5","7","9"],1]]},
{t:"Hukum nun mati dan tanwin",h:`<table><tr><th>Hukum</th><th>Huruf</th><th>Contoh</th></tr><tr><td>Idzhar halqi</td><td class="a">ء ه ع ح غ خ</td><td class="a">مَنْ آمَنَ</td></tr><tr><td>Idgham bighunnah</td><td class="a">ي ن م و</td><td class="a"><i class="g">مَنْ يَقُولُ</i></td></tr><tr><td>Idgham bilaghunnah</td><td class="a">ل ر</td><td class="a">مِنْ رَبِّهِمْ</td></tr><tr><td>Iqlab</td><td class="a">ب</td><td class="a"><i class="g">مِنْ بَعْدِ</i></td></tr><tr><td>Ikhfa</td><td class="a">15 huruf sisanya</td><td class="a"><i class="g">مِنْ قَبْلِ</i></td></tr></table><p>Ikhfa: <span class="ar">ت ث ج د ذ ز س ش ص ض ط ظ ف ق ك</span></p><aside class="note"><b>Perhatikan.</b> Iqlab: nun mati atau tanwin diubah menjadi mim samar, bibir dirapatkan ringan, dengan dengung.</aside>`,q:[["Nun mati bertemu ب hukumnya...",["Ikhfa","Iqlab","Idzhar"],1],["Nun mati bertemu ع hukumnya...",["Idzhar","Idgham","Ikhfa"],0]]},
{t:"Hukum mim mati",h:`<table><tr><th>Hukum</th><th>Syarat</th><th>Contoh</th></tr><tr><td>Ikhfa syafawi</td><td>bertemu <span class="ar">ب</span></td><td class="a"><i class="g">تَرْمِيهِمْ بِحِجَارَةٍ</i></td></tr><tr><td>Idgham mimi</td><td>bertemu <span class="ar">م</span></td><td class="a"><i class="g">لَهُمْ مَا</i></td></tr><tr><td>Idzhar syafawi</td><td>bertemu huruf lain</td><td class="a">لَهُمْ فِيهَا</td></tr></table><aside class="note"><b>Perhatikan.</b> Mim mati bertemu <span class="ar">و</span> atau <span class="ar">ف</span> harus jelas dan tidak boleh samar.</aside>`,q:[["Mim mati bertemu ب hukumnya...",["Idzhar syafawi","Ikhfa syafawi","Idgham mimi"],1],["Mim mati bertemu م hukumnya...",["Idgham mimi","Ikhfa syafawi","Idzhar syafawi"],0]]},
{t:"Hukum lam",h:`<h2>Lam jalalah</h2><p>Tafkhim (tebal) setelah fathah atau dhammah, tarqiq (tipis) setelah kasrah.</p><div class="ex"><span class="ar">قَالَ اللهُ &nbsp; بِسْمِ اللهِ</span><small>Tebal pada yang pertama, tipis pada yang kedua.</small></div><h2>Lam ta'rif</h2><table><tr><th>Hukum</th><th>Huruf</th><th>Contoh</th></tr><tr><td>Qamariyah (lam dibaca)</td><td class="a">ا ب غ ح ج ك و خ ف ع ق ي م ه</td><td class="a">الْقَمَرُ</td></tr><tr><td>Syamsiyah (lam lebur)</td><td class="a">14 huruf lainnya</td><td class="a">الشَّمْسُ</td></tr></table>`,q:[["Lam jalalah setelah kasrah dibaca...",["Tafkhim","Tarqiq","Berdengung"],1],["الشَّمْسُ termasuk...",["Qamariyah","Syamsiyah","Lam jalalah"],1]]},
{t:"Mad",h:`<p>Mad thabi'i: memanjangkan suara 2 harakat pada alif setelah fathah, ya' setelah kasrah, atau wawu setelah dhammah. Contoh: <span class="ar">قَالَ</span></p><table><tr><th>Cabang</th><th>Sebab</th><th>Panjang</th><th>Contoh</th></tr><tr><td>Wajib muttashil</td><td>hamzah satu kata</td><td>4-5</td><td class="a"><i class="m">جَاءَ</i></td></tr><tr><td>Jaiz munfashil</td><td>hamzah beda kata</td><td>2/4/5</td><td class="a"><i class="m">بِمَا أُنْزِلَ</i></td></tr><tr><td>'Aridh lissukun</td><td>waqaf</td><td>2/4/6</td><td class="a"><i class="m">الْعَالَمِينَ</i></td></tr><tr><td>Lazim</td><td>sukun asli/tasydid</td><td>6</td><td class="a"><i class="m">الضَّالِّينَ</i></td></tr></table>`,q:[["Mad thabi'i dibaca berapa harakat?",["2","4","6"],0],["Mad lazim dibaca...",["2 harakat","4 harakat","6 harakat"],2]]},
{t:"Qalqalah, ra' tafkhim dan tarqiq",h:`<h2>Qalqalah</h2><p>Pantulan suara pada huruf sukun: <span class="ar">ق ط ب ج د</span>. Sughra di tengah kata, kubra saat waqaf.</p><div class="ex"><span class="ar"><i class="q">يَقْطَعُونَ</i> &nbsp; <i class="q">أَحَدْ</i></span><small>Sughra dan kubra.</small></div><h2>Ra'</h2><table><tr><th>Hukum</th><th>Keadaan</th><th>Contoh</th></tr><tr><td>Tafkhim</td><td>fathah, dhammah, atau sukun setelahnya</td><td class="a">رَبِّ</td></tr><tr><td>Tarqiq</td><td>kasrah, atau sukun setelah kasrah</td><td class="a">رِجَالٌ</td></tr></table>`,q:[["Huruf qalqalah ada...",["3","5","7"],1],["Ra' berharakat kasrah dibaca...",["Tafkhim","Tarqiq","Idgham"],1]]},
{t:"Waqaf dan ibtida'",h:`<p>Waqaf adalah berhenti sejenak sambil mengambil nafas. Ibtida' adalah memulai bacaan kembali.</p><table><tr><th>Tanda</th><th>Arti</th></tr>${J("Waqaf lazim, harus berhenti","م")}${J("Berhenti lebih baik","ط")}${J("Boleh berhenti atau terus","ج")}${J("Boleh, terus lebih baik","ز")}${J("Jangan berhenti","لا")}</table><aside class="note"><b>Perhatikan.</b> Saat waqaf, harakat dibaca sukun. Tanwin fathah menjadi alif, dan ta marbuthah menjadi ha.</aside>`,q:[["Tanda م berarti...",["Waqaf lazim","Boleh terus","Jangan berhenti"],0],["Tanda لا berarti...",["Harus berhenti","Jangan berhenti","Boleh berhenti"],1]]},
{t:"Latihan penutup",h:`<p>Anda sudah menyelesaikan dasar tajwid. Ulangi bab yang masih terasa sulit, lalu praktikkan langsung pada ayat yang Anda baca setiap hari.</p><aside class="note"><b>Perhatikan.</b> Tajwid paling kuat dipelajari dengan mendengar dan menirukan guru secara langsung (talaqqi). Buku ini membantu memahami teorinya.</aside>`,q:[["Huruf ikhfa berjumlah...",["15","14","6"],0],["Huruf idzhar halqi keluar dari...",["Bibir","Tenggorokan","Lidah"],1],["Cara terbaik memperbaiki bacaan...",["Belajar langsung kepada guru","Hanya membaca buku","Hanya mendengar rekaman"],0]]}
];
const $=s=>document.querySelector(s),R=document.documentElement;
let cur=0,rd=new Set(),ar=1.9;
try{rd=new Set(JSON.parse(localStorage.getItem("tj")||"[]"))}catch(e){}
const show=v=>{["front","read","back"].forEach(x=>$("#"+x).hidden=x!==v);scrollTo(0,0)};
function toc(){const f=$("#s").value.trim().toLowerCase();
$("#toc").innerHTML=C.map((c,i)=>[c,i]).filter(([c])=>!f||(c.t+" "+c.h.replace(/<[^>]+>/g," ")).toLowerCase().includes(f)).map(([c,i])=>`<li><button data-i="${i}" class="${i==cur?"on":""}">${i+1}. ${c.t}${rd.has(i)?" ✓":""}</button></li>`).join("")||"<li>Tidak ada materi yang cocok.</li>";
$("#prog").textContent=rd.size+" dari "+C.length+" bab dibaca";$("#bar").style.width=rd.size/C.length*100+"%"}
function go(i){cur=i;rd.add(i);try{localStorage.setItem("tj",JSON.stringify([...rd]))}catch(e){}
const c=C[i];show("read");$("#side").classList.remove("open");
$("#ch").innerHTML=`<h1>${i+1}. ${c.t}</h1>${c.h}<section class="quiz"><h2>Kuis bab ${i+1}</h2>${c.q.map((q,n)=>`<div class="q" data-a="${q[2]}"><p>${n+1}. ${q[0]}</p>${q[1].map((o,k)=>`<button data-k="${k}">${o}</button>`).join("")}</div>`).join("")}</section><div class="pn"><button class="btn o" id="pv">Bab sebelumnya</button><button class="btn" id="nx">Bab berikutnya</button></div>`;
$("#pv").hidden=i==0;$("#nx").textContent=i==C.length-1?"Sampul belakang":"Bab berikutnya";
$("#pv").onclick=()=>go(i-1);$("#nx").onclick=()=>i<C.length-1?go(i+1):show("back");toc()}
$("#ch").onclick=e=>{const b=e.target.closest(".q button");if(!b)return;const q=b.parentNode;if(q.dataset.done)return;q.dataset.done=1;
q.querySelectorAll("button").forEach(x=>x.classList.add(x.dataset.k==q.dataset.a?"ok":x===b?"no":"x"))};
$("#toc").onclick=e=>{const b=e.target.closest("button");if(b)go(+b.dataset.i)};
$("#s").oninput=toc;$("#open").onclick=()=>go(rd.size&&cur?cur:0);
$("#mn").onclick=()=>$("#side").classList.toggle("open");
$("#tf").onclick=()=>show("front");$("#b0").onclick=()=>show("front");$("#bt").onclick=()=>{go(cur);$("#side").classList.add("open")};
const sz=d=>{ar=Math.min(3,Math.max(1.3,ar+d));R.style.setProperty("--ar",ar+"rem")};
$("#ar-").onclick=()=>sz(-.2);$("#ar+").onclick=()=>sz(.2);
$("#th").onclick=()=>{const d=(R.dataset.theme||(matchMedia("(prefers-color-scheme: light)").matches?"light":"dark"))==="dark";R.dataset.theme=d?"light":"dark"};
toc();
</script>
</body>
</html>
